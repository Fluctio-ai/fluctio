##
## Fluctio deployment config — EXAMPLE.
##
## Copy to `.env` and edit. `.env` is gitignored (see .gitignore:
## deploy/docker/.env), so put real secrets/values here, NEVER inline
## in docker-compose.yml.
##
##   cp .env.example .env

# Postgres password (used in the DSN baked into docker-compose.yml).
POSTGRES_PASSWORD=change-me

# Web port exposed on the host.
# FLUCTIO_PORT=18953

# ─── Sandbox (sibling-container pattern) ──────────────────────────────
# Data dir — MUST be an ABSOLUTE path on the host, and the SAME path is
# used inside the container (FLUCTIO_HOME). The sandbox passes this path
# verbatim to `docker create -v`, so host dockerd has to resolve it;
# named volumes break that. Default /var/lib/fluctio.
# FLUCTIO_DATA_DIR=/var/lib/fluctio

# Sandbox image — thinkany/fluctio-sandbox:latest ships Python3 + Node
# 22 + Camoufox + git/curl.
# FLUCTIO_SANDBOX_IMAGE=thinkany/fluctio-sandbox:latest
